# Little Learner Platform - Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to git.

# Flask
FLASK_APP=backend/wsgi.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me-in-production

# Database
DATABASE_URL=postgresql+psycopg2://littlelearner:littlelearner@localhost:5432/littlelearner

# JWT
JWT_SECRET_KEY=change-me-in-production
JWT_ACCESS_TOKEN_EXPIRES=3600

# Bcrypt
BCRYPT_LOG_ROUNDS=12

# CORS
CORS_ORIGINS=http://localhost:5173

# Upload limits (bytes)
UPLOAD_MAX_SIZE=5242880

# Retention (days)
RETENTION_DAYS_ACTIVITY=90
RETENTION_DAYS_DEACTIVATED=365
